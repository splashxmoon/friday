{
  "name": "friday",
  "displayName": "Friday",
  "description": "Friday's themes, its task board, Fix with Friday, and Keep / Undo on what an agent writes.",
  "version": "0.1.0",
  "publisher": "friday",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "themes": [
      {
        "label": "Friday Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/friday-dark-color-theme.json"
      },
      {
        "label": "Friday Light",
        "uiTheme": "vs",
        "path": "./themes/friday-light-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "friday.askAgent",
        "title": "Friday: Ask an agent about this"
      },
      {
        "command": "friday.askCodebase",
        "title": "Friday: Ask the codebase"
      },
      {
        "command": "friday.askCodebaseSelection",
        "title": "Friday: Ask the codebase about this selection"
      },
      {
        "command": "friday.writeCommitMessage",
        "title": "✳ Write message",
        "category": "Friday",
        "icon": "$(sparkle)"
      },
      {
        "command": "friday.switchMode",
        "title": "Friday: Switch between Agents and Code"
      },
      {
        "command": "friday.toggleAgent",
        "title": "Friday: Show or hide the agent column"
      },
      {
        "command": "friday.newTask",
        "title": "New task",
        "category": "Friday",
        "icon": "$(add)"
      },
      {
        "command": "friday.refreshTasks",
        "title": "Refresh",
        "category": "Friday",
        "icon": "$(refresh)"
      },
      {
        "command": "friday.openTask",
        "title": "Open task",
        "category": "Friday"
      },
      {
        "command": "friday.openTaskInCode",
        "title": "Open in Code",
        "category": "Friday",
        "icon": "$(link-external)"
      },
      {
        "command": "friday.fixProblem",
        "title": "Fix with Friday",
        "category": "Friday"
      },
      {
        "command": "friday.findBreak",
        "title": "Find the commit that broke this",
        "category": "Friday",
        "icon": "$(git-commit)"
      },
      {
        "command": "friday.openCommit",
        "title": "Open a commit's changes",
        "category": "Friday"
      },
      {
        "command": "friday.showTasks",
        "title": "Show tasks",
        "category": "Friday"
      },
      {
        "command": "friday.reviewChanges",
        "title": "Review this branch's changes",
        "category": "Friday",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "friday.pr.reply",
        "title": "Add to review",
        "category": "Friday"
      },
      {
        "command": "friday.pr.keepDraft",
        "title": "Keep this draft",
        "category": "Friday",
        "icon": "$(check)"
      },
      {
        "command": "friday.pr.editNote",
        "title": "Edit",
        "category": "Friday",
        "icon": "$(edit)"
      },
      {
        "command": "friday.pr.dropNote",
        "title": "Drop",
        "category": "Friday",
        "icon": "$(trash)"
      },
      {
        "command": "friday.pr.firstPass",
        "title": "Agent's first pass on this pull request",
        "category": "Friday",
        "icon": "$(sparkle)"
      },
      {
        "command": "friday.pr.submit",
        "title": "Submit review…",
        "category": "Friday",
        "icon": "$(check-all)"
      },
      {
        "command": "friday.pr.refresh",
        "title": "Refresh the pull request's comments",
        "category": "Friday",
        "icon": "$(refresh)"
      },
      {
        "command": "friday.pr.openFile",
        "title": "Open a pull request file's diff",
        "category": "Friday"
      },
      {
        "command": "friday.pr.reveal",
        "title": "Show a pull request comment",
        "category": "Friday"
      },
      {
        "command": "friday.pr.loose",
        "title": "Read an agent finding",
        "category": "Friday"
      },
      {
        "command": "friday.pr.openOnGitHub",
        "title": "Open the pull request on GitHub",
        "category": "Friday",
        "icon": "$(link-external)"
      },
      {
        "command": "friday.addRule",
        "title": "Add rule",
        "category": "Friday",
        "icon": "$(add)"
      },
      {
        "command": "friday.openRulesFile",
        "title": "Open rules file",
        "category": "Friday",
        "icon": "$(go-to-file)"
      },
      {
        "command": "friday.editRule",
        "title": "Edit rule",
        "category": "Friday",
        "icon": "$(edit)"
      },
      {
        "command": "friday.removeRule",
        "title": "Remove rule",
        "category": "Friday",
        "icon": "$(trash)"
      },
      {
        "command": "friday.refreshRules",
        "title": "Refresh rules",
        "category": "Friday",
        "icon": "$(refresh)"
      },
      {
        "command": "friday.toggleRule",
        "title": "Switch this rule",
        "category": "Friday"
      },
      {
        "command": "friday.lensAction",
        "title": "Friday: Act on a function",
        "category": "Friday"
      },
      {
        "command": "friday.editWithAgent",
        "title": "Edit the selection with an agent",
        "category": "Friday"
      },
      {
        "command": "friday.refactorAcross",
        "title": "Refactor across the codebase…",
        "category": "Friday"
      },
      {
        "command": "friday.toggleFollow",
        "title": "Follow the agent: open the files it edits",
        "category": "Friday"
      },
      {
        "command": "friday.agentStatus",
        "title": "The agent is editing this file",
        "category": "Friday"
      },
      {
        "command": "friday.marks.keep",
        "title": "Keep this change",
        "category": "Friday"
      },
      {
        "command": "friday.marks.undo",
        "title": "Undo this change",
        "category": "Friday"
      },
      {
        "command": "friday.marks.keepAll",
        "title": "Keep all the agent's changes in this file",
        "category": "Friday",
        "icon": "$(check-all)"
      },
      {
        "command": "friday.marks.undoAll",
        "title": "Undo all the agent's changes in this file",
        "category": "Friday",
        "icon": "$(discard)"
      },
      {
        "command": "friday.marks.compare",
        "title": "Compare with before the agent",
        "category": "Friday",
        "icon": "$(diff)"
      },
      {
        "command": "friday.marks.about",
        "title": "About this change",
        "category": "Friday"
      },
      {
        "command": "friday.debugAsk",
        "title": "Ask Friday about this stop",
        "category": "Friday",
        "icon": "$(sparkle)"
      },
      {
        "command": "friday.debugWithAgent",
        "title": "Debug this with an agent",
        "category": "Friday"
      },
      {
        "command": "friday.showCoverage",
        "title": "Show coverage",
        "category": "Friday"
      },
      {
        "command": "friday.coverChanged",
        "title": "Write tests for what changed",
        "category": "Friday"
      },
      {
        "command": "friday.runCoverage",
        "title": "Run coverage",
        "category": "Friday",
        "icon": "$(play)"
      },
      {
        "command": "friday.refreshCoverage",
        "title": "Refresh coverage",
        "category": "Friday",
        "icon": "$(refresh)"
      },
      {
        "command": "friday.coverFunction",
        "title": "Write tests for the uncovered lines of a function",
        "category": "Friday"
      },
      {
        "command": "friday.showStack",
        "title": "Show the stack",
        "category": "Friday"
      },
      {
        "command": "friday.restack",
        "title": "Restack",
        "category": "Friday",
        "icon": "$(repo-pull)"
      },
      {
        "command": "friday.refreshStack",
        "title": "Refresh the stack",
        "category": "Friday",
        "icon": "$(refresh)"
      },
      {
        "command": "friday.openStackPr",
        "title": "Open the pull request",
        "category": "Friday"
      },
      {
        "command": "friday.ciChecks",
        "title": "Show the pull request's checks",
        "category": "Friday"
      },
      {
        "command": "friday.ciFix",
        "title": "Fix the failing checks with Friday",
        "category": "Friday"
      },
      {
        "command": "friday.ciOpenCheck",
        "title": "Open a check's log",
        "category": "Friday"
      },
      {
        "command": "friday.ciRefresh",
        "title": "Refresh the pull request's checks",
        "category": "Friday"
      },
      {
        "command": "friday.todo.hand",
        "title": "Hand this TODO to an agent",
        "category": "Friday",
        "icon": "$(sparkle)"
      },
      {
        "command": "friday.todo.open",
        "title": "Open",
        "category": "Friday",
        "icon": "$(go-to-file)"
      },
      {
        "command": "friday.todo.refresh",
        "title": "Look for TODOs again",
        "category": "Friday",
        "icon": "$(refresh)"
      },
      {
        "command": "friday.terminal.write",
        "title": "Write a command",
        "category": "Friday"
      },
      {
        "command": "friday.terminal.explain",
        "title": "Explain the last failed command",
        "category": "Friday"
      },
      {
        "command": "friday.servers.start",
        "title": "Start",
        "category": "Friday",
        "icon": "$(play)"
      },
      {
        "command": "friday.servers.stop",
        "title": "Stop",
        "category": "Friday",
        "icon": "$(debug-stop)"
      },
      {
        "command": "friday.servers.restart",
        "title": "Restart",
        "category": "Friday",
        "icon": "$(debug-restart)"
      },
      {
        "command": "friday.servers.open",
        "title": "Open in the browser",
        "category": "Friday",
        "icon": "$(link-external)"
      },
      {
        "command": "friday.servers.openInIde",
        "title": "Open in the IDE's browser",
        "category": "Friday",
        "icon": "$(window)"
      },
      {
        "command": "friday.servers.logs",
        "title": "Show logs",
        "category": "Friday",
        "icon": "$(output)"
      },
      {
        "command": "friday.servers.refresh",
        "title": "Refresh the servers",
        "category": "Friday",
        "icon": "$(refresh)"
      },
      {
        "command": "friday.servers.menu",
        "title": "Servers",
        "category": "Friday"
      },
      {
        "command": "friday.showServers",
        "title": "Show the servers",
        "category": "Friday"
      },
      {
        "command": "friday.palette",
        "title": "Friday: Everything Friday can do here"
      },
      {
        "command": "friday.memory.add",
        "title": "Add to memory",
        "category": "Friday",
        "icon": "$(add)"
      },
      {
        "command": "friday.memory.edit",
        "title": "Edit memory",
        "category": "Friday",
        "icon": "$(edit)"
      },
      {
        "command": "friday.memory.forget",
        "title": "Forget",
        "category": "Friday",
        "icon": "$(trash)"
      },
      {
        "command": "friday.memory.refresh",
        "title": "Refresh memory",
        "category": "Friday",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "friday.askAgent",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "friday.askCodebase",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+alt+a",
        "when": "!terminalFocus"
      },
      {
        "command": "friday.switchMode",
        "key": "ctrl+e",
        "mac": "cmd+e"
      },
      {
        "command": "friday.toggleAgent",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      },
      {
        "command": "friday.editWithAgent",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus && !editorReadonly && editorHasSelection"
      },
      {
        "command": "friday.marks.keep",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && friday.markAtCursor"
      },
      {
        "command": "friday.marks.undo",
        "key": "ctrl+backspace",
        "mac": "cmd+backspace",
        "when": "editorTextFocus && friday.markAtCursor"
      },
      {
        "command": "friday.terminal.write",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "terminalFocus"
      },
      {
        "command": "friday.palette",
        "key": "ctrl+shift+'",
        "mac": "cmd+shift+'"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "friday.askAgent",
          "group": "9_friday@1",
          "when": "editorTextFocus"
        },
        {
          "command": "friday.editWithAgent",
          "group": "9_friday@2",
          "when": "editorTextFocus && !editorReadonly"
        },
        {
          "command": "friday.debugWithAgent",
          "group": "9_friday@3",
          "when": "editorTextFocus"
        },
        {
          "command": "friday.refactorAcross",
          "group": "9_friday@4",
          "when": "editorTextFocus"
        },
        {
          "command": "friday.askCodebaseSelection",
          "group": "9_friday@5",
          "when": "editorTextFocus && editorHasSelection"
        }
      ],
      "commandPalette": [
        {
          "command": "friday.askAgent",
