        },
        {
          "command": "friday.memory.forget",
          "when": "view == friday.memory && viewItem == friday.memory.entry",
          "group": "inline@2"
        }
      ],
      "editor/title": [
        {
          "command": "friday.debugAsk",
          "when": "friday.debugStopped",
          "group": "navigation@89"
        },
        {
          "command": "friday.marks.compare",
          "when": "friday.fileHasMarks",
          "group": "navigation@90"
        },
        {
          "command": "friday.marks.undoAll",
          "when": "friday.fileHasMarks",
          "group": "navigation@91"
        },
        {
          "command": "friday.marks.keepAll",
          "when": "friday.fileHasMarks",
          "group": "navigation@92"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "friday.pr.reply",
          "group": "inline",
          "when": "commentController == friday.prReview"
        }
      ],
      "comments/comment/title": [
        {
          "command": "friday.pr.keepDraft",
          "group": "inline@1",
          "when": "commentController == friday.prReview && comment == friday.draft"
        },
        {
          "command": "friday.pr.editNote",
          "group": "inline@2",
          "when": "commentController == friday.prReview && (comment == friday.draft || comment == friday.pending)"
        },
        {
          "command": "friday.pr.dropNote",
          "group": "inline@3",
          "when": "commentController == friday.prReview && (comment == friday.draft || comment == friday.pending)"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "friday",
          "title": "Friday",
          "icon": "media/friday.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "fridayChat",
          "title": "Agent",
          "icon": "media/friday.svg"
        }
      ]
    },
    "views": {
      "friday": [
        {
          "id": "friday.pullRequest",
          "name": "Pull request",
          "icon": "media/friday.svg",
          "when": "friday.prReview"
        },
        {
          "id": "friday.tasks",
          "name": "Tasks",
          "icon": "media/friday.svg"
        },
        {
          "id": "friday.stack",
          "name": "Stack",
          "icon": "media/friday.svg",
          "when": "friday.hasStack"
        },
        {
          "id": "friday.rules",
          "name": "Rules",
          "icon": "media/friday.svg",
          "when": "!friday.prReview"
        },
        {
          "id": "friday.coverage",
          "name": "Coverage",
          "icon": "media/friday.svg",
          "when": "!friday.prReview && friday.hasCoverage"
        },
        {
          "id": "friday.todos",
          "name": "TODOs",
          "icon": "media/friday.svg",
          "initialSize": 3,
          "when": "!friday.prReview && friday.hasTodos"
        },
        {
          "id": "friday.servers",
          "name": "Servers",
          "icon": "media/friday.svg",
          "when": "friday.hasServers"
        },
        {
          "id": "friday.memory",
          "name": "Memory",
          "icon": "media/friday.svg",
          "when": "!friday.prReview"
        }
      ],
      "fridayChat": [
        {
          "id": "friday.chatSpace",
          "name": "Agent"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "friday.tasks",
        "contents": "No tasks yet.\n[New task](command:friday.newTask)\nStart one from the chat beside the editor, a Fix with Friday on an error, or a failing command."
      },
      {
        "view": "friday.rules",
        "contents": "No rules yet.\nTell an agent once (\"we use pnpm\") and save it, or add one here. Every coding tool follows them in this repo.\n[Add rule](command:friday.addRule)\nThey are kept in .friday/rules.md, which the team gets with the repo.",
        "when": "workspaceFolderCount > 0"
      },
      {
        "view": "friday.rules",
        "contents": "Open a folder first: rules are kept in the project's .friday/rules.md.",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "friday.coverage",
        "contents": "No coverage report yet.\n[Run coverage](command:friday.runCoverage)\nFriday reads coverage/lcov.info, coverage/coverage-final.json or coverage.xml in this folder, then writes tests for what no test runs, starting with what changed.",
        "when": "!friday.hasCoverage"
      },
      {
        "view": "friday.stack",
        "contents": "No stack here.\nWhen a chat's changes are big, its changes card offers Split into a stack: small pull requests, each based on the last. Friday keeps them rebased here.",
        "when": "!friday.hasStack"
      },
      {
        "view": "friday.todos",
        "contents": "No TODO, FIXME or HACK comments in this folder.\nWhen you leave one in the code, it is listed here, and one click hands it to an agent to do and to remove.\n[Look again](command:friday.todo.refresh)",
        "when": "friday.todosScanned && !friday.hasTodos"
      },
      {
        "view": "friday.todos",
        "contents": "Looking for TODO comments…",
        "when": "!friday.todosScanned"
      },
      {
        "view": "friday.memory",
        "contents": "Nothing remembered yet.\nAs agents work here, in Code or Agents, what they learn (how to run it, decisions, quirks) is kept and given to every tool. Add what you know too.\n[Add to memory](command:friday.memory.add)",
        "when": "workspaceFolderCount > 0"
      },
      {
        "view": "friday.memory",
        "contents": "Open a folder first: memory is kept for the project.",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "configuration": {
      "title": "Friday",
      "properties": {
        "friday.functionActions": {
          "type": "boolean",
          "default": true,
          "description": "Show Explain, Test, Fix and Refactor above each function, method and class."
        },
        "friday.quietWhileTyping": {
          "type": "boolean",
          "default": true,
          "description": "While you type in the editor, hold Friday's chimes and toasts. They arrive as one quiet summary when you pause."
        },
        "friday.followAgent": {
          "type": "boolean",
          "default": false,
          "description": "Open each file an agent edits, beside the editor, without taking focus."
        },
        "friday.coverage": {
          "type": "boolean",
          "default": false,
          "description": "Mark the lines no test runs in the editor, and add Test above each function that has some, from the coverage report in the folder."
        },
        "friday.todoActions": {
          "type": "boolean",
          "default": true,
          "description": "Add \"Do this\" above each TODO, FIXME and HACK comment in the editor, to hand it to an agent."
        }
      }
    },
    "colors": [
      {
        "id": "friday.uncoveredLine",
        "description": "The mark for a line no test runs (Friday coverage).",
        "defaults": {
          "dark": "#d9a441",
          "light": "#b7791f",
          "highContrast": "#ffcc00",
          "highContrastLight": "#7a5200"
        }
      }
    ],
    "configurationDefaults": {
      "terminal.integrated.commandsToSkipShell": [
        "friday.terminal.write"
      ]
    }
  }
}
